# ASP.NET Core environment: Development or Production
ASPNETCORE_ENVIRONMENT=Production
# Host port for the backend API
BACKEND_PORT=8080
# Host port for the frontend
FRONTEND_PORT=3000
# The frontend origin, the only one CORS allows
FRONTEND_ORIGIN=http://localhost:3000
# The backend URL the browser calls
BACKEND_PUBLIC_URL=http://localhost:8080
