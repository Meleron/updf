# ASP.NET Core environment: Development or Production
ASPNETCORE_ENVIRONMENT=Production
# Host port for the backend API
BACKEND_PORT=8080
# Host port for the frontend
FRONTEND_PORT=3000
# Set these only when the app is not reached at http://localhost and the ports above.
# The frontend origin, the only one CORS allows (default http://localhost:FRONTEND_PORT)
# FRONTEND_ORIGIN=https://updf.example.com
# The backend URL the browser calls (default http://localhost:BACKEND_PORT)
# BACKEND_PUBLIC_URL=https://api.updf.example.com
